{
  "name": "@aquaminh/app-core",
  "version": "2.0.2",
  "description": "Shared infrastructure utilities for app-dev Next.js apps (formerly @gplc/store-core)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/encryption.d.ts",
      "default": "./dist/crypto/encryption.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/index.d.ts",
      "default": "./dist/rate-limit/index.js"
    },
    "./email": {
      "types": "./dist/email/client.d.ts",
      "default": "./dist/email/client.js"
    },
    "./cron": {
      "types": "./dist/cron/auth.d.ts",
      "default": "./dist/cron/auth.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "default": "./dist/prisma/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "next": ">=15",
    "@upstash/redis": ">=1.30",
    "@upstash/ratelimit": ">=2",
    "@upstash/qstash": ">=2 <3",
    "resend": ">=4"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "@upstash/ratelimit": {
      "optional": true
    },
    "@upstash/qstash": {
      "optional": true
    },
    "resend": {
      "optional": true
    }
  },
  "devDependencies": {
    "@upstash/qstash": "^2.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "next": "^15.0.0",
    "@upstash/redis": "^1.34.0",
    "@upstash/ratelimit": "^2.0.0",
    "resend": "^4.0.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
